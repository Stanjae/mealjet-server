# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database / Cache
MONGODB_URI=mongodb://localhost:27017/meal-jet
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Email (Resend)
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=no-reply@example.com

# Security
BANK_DETAILS_ENCRYPTION_KEY=replace_with_32_character_key

# Payments (Paystack)
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key
PAYSTACK_PUBLIC_KEY=replace_with_paystack_public_key

PAYSTACK_API_URL=replace_with_paystack_api_url